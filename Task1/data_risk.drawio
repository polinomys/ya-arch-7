        <mxCell id="u2RBE5mp-EqSR1qOzhoQ-107" value="обесценивание данных" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="u2RBE5mp-EqSR1qOzhoQ-106">
